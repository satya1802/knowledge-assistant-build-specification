# Copy to backend/.env and fill in real values for local development.
# backend/.env is gitignored -- never commit a real key.

# --- Gemini -----------------------------------------------------------------
# Required unless GEMINI_OFFLINE=1. Get one from https://aistudio.google.com/
# Never logged or returned in an error response: app.services.llm redacts it.
GEMINI_API_KEY=

# Set to 1 to use the deterministic offline stub provider instead of calling
# the real Gemini API -- no key needed, no outbound HTTP call is made. The
# automated test suite always runs with this forced on (see tests/conftest.py).
GEMINI_OFFLINE=0

# Embedding model used for document chunks and chat queries (768 dimensions).
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Answer model. Defaults to a Flash-Lite model: fast and cheap enough for chat.
GEMINI_ANSWER_MODEL=gemini-2.5-flash-lite

# --- Sessions / auth ----------------------------------------------------------
SESSION_COOKIE_NAME=session_id
# Set to 1/true behind https; local http://localhost needs it off.
SESSION_COOKIE_SECURE=0
SESSION_TTL_SECONDS=604800

# Idle expiry: a session with no authenticated request for this many seconds
# is rejected (401) on its next use and the cookie is cleared in the
# response, independent of SESSION_TTL_SECONDS above. There is no "remember
# me" option -- this idle window always applies. Defaults to 30 minutes.
SESSION_IDLE_SECONDS=1800

# --- Login lockout (per email, server-side, survives a process restart) -------
# After this many failed sign-in attempts for one email within
# LOGIN_LOCKOUT_WINDOW_SECONDS, the email is locked for
# LOGIN_LOCKOUT_DURATION_SECONDS: further attempts get the same generic
# "Incorrect email or password" error even with the correct password.
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_DURATION_SECONDS=900

# --- Self-signup ---------------------------------------------------------------
# Admin-controlled switch for self-service account creation via POST
# /auth/signup. True by default. Set to 0/false to disable: the sign-in page
# reads GET /auth/config to hide the create-account option, and the backend
# rejects POST /auth/signup with 403 even when posted directly.
SELF_SIGNUP_ENABLED=1

# --- Database -----------------------------------------------------------------
# Defaults to a local SQLite file; point at Postgres in a real deployment.
DATABASE_URL=sqlite:///./app.db

# --- Document storage -------------------------------------------------------
# Filesystem directory the original bytes of every uploaded document (POST
# /documents) are written to. Relative paths are resolved against the
# process's working directory (normally backend/). Created automatically if
# it does not exist. Persists across restarts -- in a container deployment,
# mount a persistent volume at this path.
DOCUMENT_STORAGE_DIR=./storage/documents

# Maximum accepted size, in MB, of a single document upload (POST /documents).
# A file larger than this is rejected with a 400 before any record is created.
MAX_UPLOAD_MB=25

# --- CORS -----------------------------------------------------------------
# Comma-separated list of origins the API accepts browser requests from.
# Defaults to the Vite dev server origins when unset.
ALLOWED_ORIGINS=

# --- Retrieval ---------------------------------------------------------------
# Server-side only: no request parameter or user control for either. Top-K
# chunks considered per query, and the minimum cosine similarity score
# (range -1 to 1) a chunk must reach to be returned at all.
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.62
